PORT=4000
# SQLite file shared at the repo root
DATABASE_PATH=../database/app.sqlite
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=8h
# Seeded on first boot only (if no admin exists)
ADMIN_EMAIL=admin@coastalkitchen.local
ADMIN_PASSWORD=CoastalKitchen!2026
# Restaurant timezone: used for the open-now status once hours are verified
SHOP_TIMEZONE=America/Los_Angeles
# Spam protection: max contact-form messages per IP per 10 minutes
INQUIRY_RATE_LIMIT=5
RESERVATION_RATE_LIMIT=5
